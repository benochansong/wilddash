; WILD DASH 3D - Godot project
; RC2 Character & Chimera Build
config_version=5

[application]
config/name="WILD DASH 3D"
config/version="0.9.0-rc2"
run/main_scene="res://scenes/main.tscn"

[autoload]
GameManager="*res://scripts/game_manager.gd"
ResultManager="*res://scripts/result_manager.gd"
RaceManager="*res://scripts/race_manager.gd"
InputManager="*res://scripts/input_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
ItemSystem="*res://systems/item_system.gd"
PerformanceManager="*res://scripts/performance_manager.gd"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
