{
  "name": "wild-dash-50",
  "version": "1.0.0",
  "description": "WILD DASH 50 동물 서바이벌 레이싱 데스크톱 게임",
  "author": "WILD DASH 50",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env DESKTOP_DEV_URL=http://127.0.0.1:5173 electron .\"",
    "dist:win": "npm run build && electron-builder --win nsis",
    "test": "npm run build && node --test tests/desktop-build.test.mjs",
    "lint": "eslint app src electron"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "electron": "39.8.3",
    "electron-builder": "26.0.12",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.0.13",
    "wait-on": "9.0.4"
  },
  "build": {
    "appId": "com.wilddash50.game",
    "productName": "WILD DASH 50",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WILD DASH 50"
    },
    "artifactName": "WILD-DASH-50-Setup-${version}.${ext}"
  }
}
